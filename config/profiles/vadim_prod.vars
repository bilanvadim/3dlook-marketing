# Profile: vadim_prod
#
# Per-user values for ONE canonical repo. NO SECRETS LIVE HERE — this file is committed.
# Secrets stay in ~/.config/ai-agent-stack/secrets.env (0600), which is never in git,
# and each user's set is entirely their own (own Telegram bot, own provider keys).
#
# See config/README.md for the clean-clone → render model.

# ── identity / render tokens ─────────────────────────────────────────────────
PROFILE_USER=vadim_prod
PROFILE_HOME=/home/vadim_prod
PROFILE_DEST=/srv/vadim_prod/ai-agents-config
# Quoted: this file is `source`d, so an unquoted two-word value runs the second word as a
# command ("Bilan: command not found") and leaves the variable holding only "Vadim".
PROFILE_OWNER="Vadim Bilan"
PROFILE_GH_OWNER=bilanvadim
# His work lives in one project repo rather than a workspaces/ tree.
PROFILE_PROJECT_ROOT=/home/vadim_prod/3dlook-marketing

# ── ports: distinct from sergiy_prod's on the same loopback ──────────────────
# 3001 is what his conductor already binds and what any future gateway forward will
# target, so it stays; sergiy_prod moved to 3011 instead.
PROFILE_HO_WEBHOOK_PORT=3001
PROFILE_QDRANT_HTTP_PORT=6353
PROFILE_QDRANT_GRPC_PORT=6354
PROFILE_PROXY_AGENTIC_PORT=47831
PROFILE_PROXY_STRONG_PORT=47832

# ── conductor state ──────────────────────────────────────────────────────────
# His queue history (77 jobs) was sitting inside the 3dlook-marketing project checkout,
# where the service unit could not see it after the reinstall pointed at the canonical
# tree — a restart would have started him on an empty queue. State moves to ~/.hermes.
PROFILE_CONDUCTOR_DB=/home/vadim_prod/.hermes/ho.db

# ── service topology ─────────────────────────────────────────────────────────
# Everything is a user unit here (linger enabled), including the conductor — unlike
# sergiy_prod, where the conductor is a system unit. Scripts must resolve the scope
# per profile rather than assume one.
PROFILE_UNIT_SCOPE_CONDUCTOR=user
PROFILE_UNIT_SCOPE_DEFAULT=user

# ── role ─────────────────────────────────────────────────────────────────────
# CONSUMER: a read-only clone (deploy key with write disabled on the GitHub side). It must never
# carry local commits — they would be invisible to the other runtime and lost by the next
# reset-and-render that update.sh performs. diff.sh reports "ahead of origin" here as an error.
PROFILE_ROLE=consumer
