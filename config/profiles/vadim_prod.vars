# Per-account values for this deployment. NOTHING SECRET GOES HERE — secrets live only in
# ~/.config/ai-agent-stack/secrets.env (0600, never committed).
#
# WHY THIS FILE EXISTS AT ALL: the VPS is shared with another account running the same
# stack, and a busy port does not raise an error — llmfp simply binds the NEXT free one.
# That is not theoretical here. On 2026-08-27 an orphaned proxy took :47832, the real
# strong instance fell back to :47833, and Hermes' heavy mode plus every OpenCode fallback
# spoke to the wrong process for 21 hours with nothing logged. Ports are the main reason
# a per-account file is needed rather than constants in the templates.
#
# The spec's numbers (47821/47822, 6343/6344, 3011) belong to the OTHER account. They are
# live listeners on this box. Do not copy them.

PROFILE_USER=vadim_prod
PROFILE_HOME=/home/vadim_prod
PROFILE_OWNER=Vadim Bilan
PROFILE_GH_OWNER=bilanvadim
PROFILE_PROJECT_ROOT=/home/vadim_prod/3dlook-marketing
PROFILE_WORKSPACES=/home/vadim_prod/workspaces

# ── ports: the reason this file is not optional ──
PROFILE_AGENTIC_PORT=47831        # llm-failover-proxy, everyday chain + Vision/Embedding/Judge
PROFILE_STRONG_PORT=47832         # llm-failover-proxy, coding agent + heavy mode
PROFILE_QDRANT_HTTP_PORT=6353     # mem0 vector store
PROFILE_QDRANT_GRPC_PORT=6354
PROFILE_HO_WEBHOOK_PORT=3001      # conductor escalation webhook
PROFILE_SEARXNG_URL=http://127.0.0.1:8888   # shared on this host, not ours to move

# ── unit scopes ──
# The conductor is a systemd --user unit HERE, inverting the spec, and deliberately: the
# SYSTEM-scope hermes-conductor.service on this host belongs to sergiy_prod (User=
# sergiy_prod, its own tree, its own ho.db). Enabling a system unit for us would put two
# workers on one queue.
PROFILE_UNIT_SCOPE_CONDUCTOR=user
PROFILE_UNIT_SCOPE_DEFAULT=user

# ── paths ──
PROFILE_HERMES_HOME=/home/vadim_prod/.hermes
PROFILE_HO_DB=/home/vadim_prod/.hermes/ho.db
PROFILE_LLMFP_PREFIX=/home/vadim_prod/.local   # NOT /usr: that install is shared with the other account
PROFILE_TELEGRAM_BOT=dlookmarketing_bot
PROFILE_TIMEZONE=Europe/Kyiv                   # both morning timers; an OnCalendar with no
                                               # zone token silently means UTC, which is how
                                               # the update and the model pick ended up in
                                               # the wrong order
