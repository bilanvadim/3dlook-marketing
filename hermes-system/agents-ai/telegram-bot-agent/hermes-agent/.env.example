# Скопировать в ~/.hermes/.env и заполнить реальными значениями, затем:
#   chmod 600 ~/.hermes/.env
# Подробности "как получить значения" — см. SETUP.md §4.

# === Провайдеры LLM (OpenCode) ===
OPENCODE_GO_API_KEY=sk-YOUR_OPENCODE_GO_KEY
OPENCODE_ZEN_API_KEY=sk-YOUR_OPENCODE_ZEN_KEY
# (GO и ZEN могут быть одним ключом, если провайдер один)

# === Telegram ===
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF_your_bot_token_from_BotFather
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID
# Optional: a "home channel" the bot posts status/digests to (id + topic thread)
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=

# === AI Second Brain (Obsidian wiki) ===
WIKI_PATH=/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/hermes-agent/AI-Second-Brain
OBSIDIAN_VAULT_PATH=/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/hermes-agent/AI-Second-Brain

# === STT (распознавание голосовых сообщений) ===
GROQ_API_KEY=your_groq_api_key

# === Browser (опционально) ===
AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
BROWSER_SESSION_TIMEOUT=600
BROWSER_INACTIVITY_TIMEOUT=120
# Browserbase (опционально — облачный headless-браузер вместо локального)
BROWSERBASE_ADVANCED_STEALTH=false
BROWSERBASE_PROXIES=false

# === Terminal tool (опционально) ===
TERMINAL_LIFETIME_SECONDS=1800
TERMINAL_TIMEOUT=120
TERMINAL_MODAL_IMAGE=

# === Debug-флаги инструментов (опционально; 1 = verbose логи) ===
IMAGE_TOOLS_DEBUG=0
VISION_TOOLS_DEBUG=0
WEB_TOOLS_DEBUG=0
MOA_TOOLS_DEBUG=0

# === Gemini failover (опционально, для vps-orchestration skill) ===
GEMINI_API_KEY=your_gemini_api_key

# === Mem0 OSS через Gemini ===
# Mem0's OpenAI adapter uses this variable name for the Gemini key.
# The endpoint and models are configured in mem0.json.example.
OPENAI_API_KEY=your_gemini_api_key_for_mem0

# === Прочие опциональные ключи (раскомментировать при использовании) ===
# OPENROUTER_API_KEY=       # fallback-провайдер (см. config.yaml fallback_model)
# GITHUB_TOKEN=             # git-операции агента / gh CLI; заодно снимает лимит
#                           # Skills Hub 60 -> 5000 req/hr (`gh auth token`)
# SEARXNG_URL=http://127.0.0.1:8888   # веб-поиск, см. ops/searxng/README.md.
#                           # ТОЛЬКО здесь: `hermes config set` кладёт в config.yaml,
#                           # а провайдер читает environ/.env
# VERCEL_TOKEN=             # деплой на Vercel
# EXA_API_KEY=             # web-search провайдер
# FIRECRAWL_API_KEY=       # web-scraping
