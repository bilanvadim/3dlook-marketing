{
  "_comment": "Copy to ~/.claude/settings.json. 'enabledPlugins' is rewritten by DEV/switch-profile.sh — this shows the default (dev) active set. Replace YOUR_USER in the marketplace paths (they must be absolute). The 'test' system (ai-agents-mvb*) points at the repo-captured copies.",
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "theme": "dark-daltonized",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "hermes-core@dev": true,
    "hermes-design@dev": true,
    "hermes-frontend@dev": true,
    "hermes-backend@dev": true,
    "hermes-data@dev": true,
    "hermes-platform@dev": true,
    "hermes-quality@dev": true,
    "hermes-sre@dev": true,
    "hermes-scout@dev": true,
    "hermes-verify@dev": true,
    "hermes-ecc@dev": true
  },
  "extraKnownMarketplaces": {
    "dev":        { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/dev" } },
    "seo":        { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/seo" } },
    "marketing":  { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing" } },
    "security":   { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/security" } },
    "ai-agents-mvb":    { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing_vb" } },
    "ai-agents-mvb-sm": { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing_vb_sm" } }
  }
}
