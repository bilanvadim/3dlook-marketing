{
  "_comment": "Copy to ~/.claude/settings.json. 'enabledPlugins' is rewritten by DEV/switch-profile.sh — this shows the default (dev-sm) active set. Replace YOUR_USER in the marketplace paths (they must be absolute). The 'test' system (ai-agents-mvb*) points at the repo-captured copies.",
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "theme": "dark-daltonized",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "hermes-core@dev-sm": true,
    "hermes-design@dev-sm": true,
    "hermes-frontend@dev-sm": true,
    "hermes-backend@dev-sm": true,
    "hermes-data@dev-sm": true,
    "hermes-platform@dev-sm": true,
    "hermes-quality@dev-sm": true,
    "hermes-sre@dev-sm": true,
    "hermes-scout@dev-sm": true,
    "hermes-verify@dev-sm": true,
    "hermes-ecc@dev-sm": true
  },
  "extraKnownMarketplaces": {
    "dev-sm":        { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/dev-sm" } },
    "seo-sm":        { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/seo-sm" } },
    "marketing-sm":  { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing-sm" } },
    "security-sm":   { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/security-sm" } },
    "ai-agents-mvb":    { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing_vb" } },
    "ai-agents-mvb-sm": { "source": { "source": "directory", "path": "/srv/YOUR_USER/ai-agents-config/agents-ai/telegram-bot-agent/claude-code-agent/DEV/marketing_vb_sm" } }
  }
}
