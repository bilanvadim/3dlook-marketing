{
  "_comment": "User-scope MCP servers — merge this 'mcpServers' object into ~/.claude.json (applies to EVERY Claude session), or add each with `claude mcp add ... --scope user`. Fill the API_KEY placeholder. Needs Node/npx.",
  "mcpServers": {
    "magic": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": { "API_KEY": "REPLACE_WITH_21ST_MAGIC_KEY" }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  }
}
