# Hermes Orchestrator conductor — environment
# --- Auth: pick ONE path ---
# A) Subscription (draws from your monthly Agent SDK credit pool, separate from interactive usage):
#    leave ANTHROPIC_API_KEY unset; the bundled Claude Code CLI uses your logged-in plan.
# B) API billing:
ANTHROPIC_API_KEY=

# --- State (required): SQLite / libSQL via @libsql/client ---
# Default = a local single file (zero infra):
DATABASE_URL=file:./ho.db
# Or a networked/shared DB with the SAME code — a libSQL server or Turso Cloud:
#   DATABASE_URL=libsql://<db>-<org>.turso.io?authToken=<token>
#   DATABASE_URL=http://127.0.0.1:8080          # self-hosted sqld

# --- Circuit breaker / resume (no budget cap by design — cost is not optimized) ---
# Every value below is read through posEnv(): a BLANK or non-positive value falls back to the
# documented default rather than becoming a real 0.
HO_IDLE_MS=10000                    # poll interval when no jobs
HO_WORKER_ID=                       # optional; defaults to ho-<pid>
HO_RESUME_BACKOFF_SECS=3600         # wait before resuming after a token/rate limit with no retry-after
HO_STALE_RUN_SECS=900               # a run stuck this long (crashed worker) is requeued for resume
HO_HEARTBEAT_MS=60000               # bump claimed_at while a job streams, so a sibling worker won't recover a LIVE job
HO_MAX_ATTEMPTS=5                   # retire a job that keeps killing its worker instead of spinning forever
CONDUCTOR_WORKERS=1                 # parallel worker loops in this process (claims are atomic)
HO_STUCK_REPEATS=6                  # identical MUTATING turns before calling it a loop
HO_STUCK_REPEATS_READONLY=15        # ditto for Read/Grep/WebSearch — repetition there is research, not a spin
# Lock contention on the local DB. The libSQL driver is SYNCHRONOUS: waiting inside it freezes
# the whole process (webhook, heartbeats, every worker), so keep the in-driver wait SHORT and let
# the async retry ladder do the waiting. Raising HO_BUSY_TIMEOUT_MS is the wrong lever.
HO_BUSY_TIMEOUT_MS=500
HO_BUSY_RETRIES=6

# --- Rate-limit backoff ladder (60s → 5min → 15min → cap) ---
HO_MIN_PROGRESS_TURNS=10            # turns a run must make before a pause counts as "the window is open"
HO_PAUSE_MAX_BACKOFF_SECS=1800      # last rung of the ladder; it repeats forever
HO_PAUSE_NOTIFY_MIN_SECS=600        # only announce a pause this long (or a job's first) — silence for short retries

# --- Escalation (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HO_ESC_WAIT_SECS=1800               # how long to wait for a human before parking the job
HO_ESC_REMIND_SECS=600              # re-ping Telegram this often while the escalation sits unanswered
HO_ESC_PARK_SECS=1800               # how long a parked job sleeps before asking again
HO_MAX_ESC_PARKS=8                  # give up (leave it 'escalated') after this many unanswered cycles
HO_TURN_GRANT=60                    # extra turns granted when a human waves a `turns` escalation through
HO_MAX_CONTINUES=5                  # how many times ONE run may be resumed by a human "continue"

# --- Escalation callbacks: PER-USER, and it must not be left to the default ---
# The webhook binds a real TCP port. Every runtime on the box that ships this conductor wants one,
# so two users on the shared default silently gave the port to whichever started first and the
# second one's Approve/Deny taps went nowhere. Assign a distinct port per profile.
HO_WEBHOOK_PORT=3001
HO_WEBHOOK_HOST=127.0.0.1           # loopback only: an open escalation endpoint lets anyone approve a gated action
# REQUIRED, or every callback is refused with 401. Sent as X-Telegram-Bot-Api-Secret-Token — the
# header Telegram itself uses (setWebhook's secret_token), so the check works for a forwarded update
# and a direct one alike. Loopback is NOT sufficient on a multi-account box: a forged
# {"callback_query":{"data":"ho:approve:<id>"}} was accepted, deciding gated actions and forging
# decided_by. deploy.sh generates one; keep it out of git like any other secret.
HO_WEBHOOK_SECRET=
# Set to 1 ONLY when nothing else consumes this bot: Telegram allows exactly one getUpdates
# reader per token, so enabling this alongside the Hermes gateway makes both lose updates.
HO_TELEGRAM_POLLING=

# --- Pre-run snapshot (recovery point before an autonomous run) ---
# Either point HO_SNAPSHOT_SH straight at the script, or set HERMES_REPO_ROOT and it is found at
# $HERMES_REPO_ROOT/hermes_agent/ops/conductor-snapshot.sh. Writes refs/hermes/snapshots/job-<id>.
HERMES_REPO_ROOT=
HO_SNAPSHOT_SH=
