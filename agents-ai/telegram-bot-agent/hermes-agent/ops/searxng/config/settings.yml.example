# SearXNG для web_search Хермеса — приватный инстанс, только localhost.
# Правится руками; шаблон без секрета — в репо ai-agents-config.
use_default_settings: true

general:
  instance_name: "Hermes SearXNG"
  donation_url: false
  contact_url: false
  enable_metrics: false

server:
  secret_key: "REPLACE_ME"   # python3 -c "import secrets;print(secrets.token_hex(32))"
  # Приватный инстанс: штатный limiter отдавал бы 429 нашему же агенту.
  limiter: false
  public_instance: false
  image_proxy: false

search:
  # json НЕТ в дефолтах upstream, а провайдер Хермеса зовёт /search?format=json
  formats:
    - html
    - json
  safe_search: 0
  autocomplete: ""
  # Сервер в Германии, и движки геолоцируют выдачу по IP — на русский/
  # французский запрос сыпались немецкие сниппеты. auto = язык из запроса.
  default_lang: "auto"

ui:
  static_use_hash: true
