# conductor-bridge — copy to ~/.hermes/conductor-bridge/bridge.env, fill, chmod 600
#
# Small stdlib HTTP service that accepts an authenticated job payload (e.g. from a
# docker container on the bridge network) and INSERTs a row into the Hermes
# conductor queue (~/.hermes/ho.db → ho_jobs), which hermes-conductor.service runs.
# Reachable only from the docker bridge gateway; every request must carry the token.

# Shared secret — the caller must send this (compared with hmac.compare_digest).
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CONDUCTOR_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Bind address — the docker bridge gateway IP (containers reach the host here).
BRIDGE_HOST=172.20.0.1
BRIDGE_PORT=8790

# Defaults applied to jobs that don't specify them.
BRIDGE_DEFAULT_PROFILE=dev
BRIDGE_DEFAULT_WORKDIR=/home/YOUR_USER/workspaces
# Where a job with no work_dir runs. Point it at the PROJECTS ROOT, not at one
# project: a stale single-project default sends every job to a directory that may
# no longer exist. Empty → HERMES_CLAUDE_SWITCHER_WORKDIR, then ~/workspaces.
BRIDGE_DEFAULT_MAX_TURNS=40

# Optional: override the conductor DB path (defaults to ~/.hermes/ho.db)
# HO_DB=/home/YOUR_USER/.hermes/ho.db
