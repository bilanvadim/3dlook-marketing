# mtproto — copy to ~/.hermes/mtproto/creds.env, fill, chmod 600
#
# Used by list_topics.py to list LIVE forum topics of the bot chat via the user's
# own MTProto session (the Bot API can't see topics the user deleted/closed).
# The session itself lives Fernet-encrypted in ~/.hermes/mtproto/session.enc and
# is decrypted in memory only — never commit session.enc or the raw session string.

# Telegram API credentials — create an app at https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here

# Fernet key that encrypts session.enc at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MTPROTO_SESSION_KEY=REPLACE_WITH_FERNET_KEY
