{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Safety + capability baseline for this repo root, mirroring claude_code/DEV/full_stack_sm/.claude/settings.json. The Conductor opens SDK sessions with settingSources:['project'] and cwd=work_dir, so a job whose work_dir is this repo root previously loaded no settings at all: no guard hook, and every Bash call denied for want of an allow rule — which is why an A→Z run on the dev or seo profile could not actually do anything here. 'ask' is deliberately omitted: a headless session cannot answer a prompt, so irreversible actions are gated by the Conductor's ASK_PATTERNS over Telegram and by guard.py instead.",
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(ls*)", "Bash(cat*)", "Bash(head*)", "Bash(tail*)", "Bash(wc*)", "Bash(find*)",
      "Bash(grep*)", "Bash(rg*)", "Bash(sed -n*)", "Bash(awk*)", "Bash(sort*)", "Bash(uniq*)",
      "Bash(mkdir*)", "Bash(cp*)", "Bash(mv*)", "Bash(touch*)",
      "Bash(python3*)", "Bash(pip3*)", "Bash(pip*)", "Bash(node*)", "Bash(npx*)",
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npm ci)", "Bash(pnpm *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git checkout -b *)", "Bash(git switch *)",
      "Bash(git push)", "Bash(git push origin *)", "Bash(git push -u *)",
      "Bash(gh pr create*)", "Bash(gh pr view*)", "Bash(gh run *)",
      "Bash(sqlite3*)", "Bash(jq*)", "Bash(curl -s*)",
      "WebSearch", "WebFetch(*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Read(**/secrets.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.credentials.json)",
      "Read(**/auth.json)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(gh pr merge*)",
      "Bash(* | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
