{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Hermes permission baseline. Allow safe read/build ops; confirm or block dangerous ones. Adjust per project.",
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npm ci)", "Bash(pnpm *)", "Bash(yarn *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add*)",
      "Bash(git commit*)", "Bash(git checkout -b *)", "Bash(git switch *)",
      "Bash(git push)", "Bash(git push origin *)", "Bash(git push -u *)",
      "Bash(gh run *)", "Bash(gh workflow view*)", "Bash(gh pr create*)", "Bash(gh pr view*)",
      "Bash(npx playwright*)", "Bash(npx vitest*)", "Bash(pytest*)",
      "Bash(python3 *)", "Bash(node *)", "Bash(tsc*)", "Bash(eslint*)",
      "Bash(supabase migration new*)", "Bash(supabase db diff*)"
    ],
    "ask": [
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(gh pr merge*)", "Bash(gh release*)",
      "Bash(vercel deploy*)", "Bash(vercel --prod*)",
      "Bash(wrangler deploy*)", "Bash(wrangler publish*)",
      "Bash(supabase db push*)", "Bash(supabase migration up*)",
      "Bash(terraform apply*)", "Bash(terraform destroy*)",
      "Bash(docker push*)",
      "Write", "Edit"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(**/secrets/**)", "Read(**/*.pem)", "Read(**/id_rsa*)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(rm -rf .git*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(* | bash)", "Bash(curl * | sh)", "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/autocommit.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/clear-counter.py" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-handoff.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-handoff.py" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-handoff.py" }
        ]
      }
    ]
  }
}
