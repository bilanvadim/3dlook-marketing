# Hermes Conductor — environment
# --- Auth: pick ONE path ---
# A) Subscription (draws from your monthly Agent SDK credit pool, separate from interactive usage):
#    leave ANTHROPIC_API_KEY unset; the bundled Claude Code CLI uses your logged-in plan.
# B) API billing:
ANTHROPIC_API_KEY=

# --- State (required): direct PostgreSQL connection (no Supabase layer) ---
# Point at any Postgres. On this VPS the engine is the self-hosted instance; on the docker
# network reach it as host `supabase-db` (or a dedicated postgres container). Server-side only.
DATABASE_URL=postgresql://postgres:YOUR_PG_PASSWORD@supabase-db:5432/postgres
HC_PG_POOL=4                        # max pool connections

# --- Circuit breaker / resume (no budget cap by design — cost is not optimized) ---
HC_IDLE_MS=10000                    # poll interval when no jobs
HC_WORKER_ID=                       # optional; defaults to hc-<pid>
HC_RESUME_BACKOFF_SECS=3600         # wait before resuming after a token/rate limit with no retry-after
HC_STALE_RUN_SECS=900               # a run stuck this long (crashed worker) is requeued for resume

# --- Escalation (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
