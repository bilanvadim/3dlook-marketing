# Hermes Orchestrator conductor — environment
# --- Auth: pick ONE path ---
# A) Subscription (draws from your monthly Agent SDK credit pool, separate from interactive usage):
#    leave ANTHROPIC_API_KEY unset; the bundled Claude Code CLI uses your logged-in plan.
# B) API billing:
ANTHROPIC_API_KEY=

# --- State (required): SQLite / libSQL via @libsql/client ---
# LEAVE THIS UNSET for a local file DB. conductor-run.sh then resolves it to
# file:$HO_STATE_DIR/ho.db (= ~/.hermes/ho.db) — an ABSOLUTE path, which is the
# whole point.
#
# Do NOT put a relative value here. This file is loaded via systemd
# EnvironmentFile=, and systemd resolves `file:./ho.db` against the unit's
# WorkingDirectory, not against this file. On 2026-08-22 that cost a real outage
# shape: a drop-in had moved WorkingDirectory to another tree, so the worker would
# have opened a 0-byte ho.db there while the monitor and the gateway both read
# ~/.hermes/ho.db — a conductor polling an empty queue forever, no error anywhere.
# EnvironmentFile= also OVERRIDES Environment=, so a correct absolute value in a
# drop-in cannot save you from a relative one here.
#
# Set it explicitly only to go networked (see below), or to pin an absolute path.
#DATABASE_URL=file:/home/YOUR_USER/.hermes/ho.db
# Or a networked/shared DB with the SAME code — a libSQL server or Turso Cloud:
#   DATABASE_URL=libsql://<db>-<org>.turso.io?authToken=<token>
#   DATABASE_URL=http://127.0.0.1:8080          # self-hosted sqld

# --- Circuit breaker / resume (no budget cap by design — cost is not optimized) ---
HO_IDLE_MS=10000                    # poll interval when no jobs
HO_WORKER_ID=                       # optional; defaults to ho-<pid>
HO_RESUME_BACKOFF_SECS=3600         # wait before resuming after a token/rate limit with no retry-after
HO_STALE_RUN_SECS=900               # a run stuck this long (crashed worker) is requeued for resume

# --- Escalation (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
