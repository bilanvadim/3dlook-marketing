{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": "@STRONG_PORT@",
    "apiKey": "@LLMFP_LOCAL_KEY@",
    "cors": true,
    "logLevel": "info"
  },
  "failover": {
    "requestTimeoutMs": 300000,
    "firstTokenTimeoutMs": 45000,
    "idleTimeoutMs": 90000,
    "hedgeDelayMs": 5000,
    "maxInFlight": 3,
    "maxAttempts": 0,
    "crossModelFallback": true,
    "treatContentFilterAsFailure": true,
    "streamErrorAsMessage": true,
    "strictModelMatch": false,
    "cooldown": {
      "failuresBeforeTrip": 2,
      "baseMs": 15000,
      "maxMs": 300000
    }
  },
  "probe": {
    "timeoutMs": 15000
  },
