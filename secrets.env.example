# =============================================================================
# secrets.env — ЕДИНСТВЕННЫЙ файл, который заполняешь руками.
# Всё, что нужно системе, собрано здесь. Скопируй, заполни, запусти install.sh:
#
#   cp secrets.env.example secrets.env && nano secrets.env && ./install.sh
#
# Пустую строку можно оставить: install.sh либо спросит значение в диалоге, либо
# (с --yes) пропустит необязательное и допишет в TODO. НИКОГДА не коммить
# secrets.env — только этот .example. install.sh делает chmod 600 всему.
#
# Обозначения:  [REQ] без него установка остановится · [РЕК] рекомендуется —
# без него часть системы не работает · [ОПЦ] можно позже.
# Подробное «что откуда берётся» — раздел «Что нужно от тебя» в README.md.
# =============================================================================

# ── [REQ] Телеграм: твой бот и ты сам ────────────────────────────────────────
# Токен бота: @BotFather → /newbot (или /mybots → API Token у готового).
# Вид: 8123456789:AAF... — это и есть «id бота» + секрет в одной строке.
TELEGRAM_BOT_TOKEN=
# ТВОЙ числовой user id: @userinfobot → Id. Только он сможет писать боту;
# остальные получают отказ. Несколько — через запятую, без пробелов.
TELEGRAM_ALLOWED_USERS=

# ── [REQ] Мозг менеджера (Hermes) ────────────────────────────────────────────
# opencode.ai → вход → Dashboard → API keys. GO = основная модель Hermes,
# ZEN = бесплатный тир для запасного кодера; часто это ОДИН И ТОТ ЖЕ ключ.
# Если оставить ZEN пустым, install.sh подставит в него значение GO.
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=

# ── [РЕК] Бесплатные провайдеры моделей (запасной кодер + фолбэки) ───────────
# Роутер каждое утро выбирает сильнейшую бесплатную модель из провайдеров,
# у которых ЕСТЬ ключ. Ключей нет → выбирать не из чего, и бот попросит их
# в Телеграме. Топ-3 по числу бесплатных моделей на 08.08.2026 — NVIDIA NIM,
# ModelScope, Cloudflare Workers AI.
NVIDIA_API_KEY=               # build.nvidia.com → API key (нужна верификация по телефону)
MODELSCOPE_API_KEY=           # modelscope.cn/my/myaccesstoken
                              # ⚠️ ПОСЛЕ выпуска токена обязательно привяжи аккаунт
                              #    Alibaba Cloud: modelscope.ai/my/settings/account —
                              #    иначе генерация отдаёт 401 при валидном токене
CLOUDFLARE_API_KEY=           # dash.cloudflare.com/profile/api-tokens (Workers AI)
                              # ⚠️ токен вида cfat_… не проходит /user/tokens/verify —
                              #    это норма, ключ рабочий
CLOUDFLARE_ACCOUNT_ID=        # можно не заполнять — роутер найдёт по токену сам
OPENROUTER_API_KEY=           # openrouter.ai/keys — вне ротации с 08.08.2026
                              #    (у репо-источника переехал в Renewable Credits),
                              #    но остаётся полезным фолбэком

# ── [РЕК] Память и голос ─────────────────────────────────────────────────────
GEMINI_API_KEY=               # aistudio.google.com/app/apikey — эмбеддинги mem0
                              #    (без него долговременная память мертва) + фолбэк
GROQ_API_KEY=                 # console.groq.com/keys — расшифровка голосовых (STT);
                              #    без него голосом боту писать нельзя

# ── [ОПЦ] MTProto + userbot (выбор живых топиков при форварде) ───────────────
# Одно приложение покрывает оба: my.telegram.org → API development tools.
# Без этого бот работает, но пропадает пикер «в какой топик положить форвард».
TG_API_ID=                    # числовой
TG_API_HASH=                  # 32 символа
TG_PHONE=                     # +00000000000 — телефон аккаунта-юзербота (для логина)
TG_PASSWORD=                  # облачный пароль 2FA, если он стоит (иначе пусто)

# ── [ОПЦ] MCP-серверы и инструменты Claude Code ─────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN= # github.com/settings/tokens — github MCP + git-операции
POSTGRES_CONNECTION_STRING=   # postgres MCP, если есть своя база
MAGIC_API_KEY=                # 21st.dev — MCP генерации UI

# ── ГЕНЕРИРУЮТСЯ САМИ, если оставить пустыми (трогать не нужно) ──────────────
MTPROTO_SESSION_KEY=          # Fernet-ключ, шифрует MTProto-сессию на диске
CONDUCTOR_BRIDGE_TOKEN=       # общий секрет внешнего мостика задач

# ── SEO keyword data (Ahrefs API v3) ─────────────────────────────────────────
# Feeds `keywords_raw` for the SEO pipeline via marketing_vb/scripts/ahrefs-keywords.py.
# Without it seo-planner marks volume/difficulty TBD instead of inventing figures —
# degraded, not broken. Create in Ahrefs → Account settings → API keys.
# A "Standard 2022" legacy plan DOES carry the full 400,000 units/month; the docs
# do not say so, GET /v3/subscription-info/limits-and-usage does.
AHREFS_API_KEY=

# ── llm-failover-proxy chains (local, no external account) ───────────────────
# Both proxies run on loopback; the keys are the ones the proxy itself expects, so
# they are per-install values rather than vendor secrets. Ports are pinned per user
# so two accounts on one box do not collide (see config/profiles/*.vars).
# ⚠️ THE PORTS BELOW ARE THIS ACCOUNT'S, and they are NOT tokenised on purpose.
#
# Hermes derives the variable NAME from the base_url — 127.0.0.1:47831 becomes
# HERMES_CUSTOM_127_0_0_1_47831_API_KEY — so a token in the name would break the
# derivation, not parameterise it. On another machine, change the port here AND in
# config/profiles/<user>.vars, and keep the two in agreement.
#
# Why they are not the spec's 47821/47822: those belong to the other account on this
# host and are live listeners. A busy port raises no error — llmfp binds the next free
# one — which on 2026-08-27 put an orphan on the strong port for 21 hours.
HERMES_AGENTIC_CHAIN_URL=http://127.0.0.1:47831/v1
HERMES_STRONG_CHAIN_URL=http://127.0.0.1:47832/v1
HERMES_CUSTOM_127_0_0_1_47831_API_KEY=
HERMES_CUSTOM_127_0_0_1_47832_API_KEY=

# ── Telegram home channel ────────────────────────────────────────────────────
# Chat/channel Hermes treats as "home" for unsolicited posts. Numeric id, no @.
TELEGRAM_HOME_CHANNEL=

# ── НЕ ключи, но без них система неполная (install.sh напомнит в конце) ──────
#  1. Claude Code: sudo npm i -g @anthropic-ai/claude-code && claude  → /login
#     (подписка Max/Pro; ANTHROPIC_API_KEY НЕ нужен — дирижёр ходит подпиской)
#  2. hermes auth — OAuth провайдера Hermes, если он его требует
#  3. Профиль системы: claude-code-agent/DEV/switch-profile.sh full_stack_sm
