{
  "$schema": "https://opencode.ai/config.json",
  // Запасной кодинг-агент ходит через llm-failover-proxy (сильная цепочка, @STRONG_PORT@).
  // Выбор модели делает прокси перебором, а не жёстко прописанное имя.
  "model": "llm-fop-strong/auto",
  "small_model": "llm-fop-strong/auto",
  "provider": {
    "llm-fop-strong": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llm-failover-proxy (strong)",
      "options": { "baseURL": "http://127.0.0.1:@STRONG_PORT@/v1" },
      "models": { "auto": { "name": "auto (failover: список A)" } }
    }
  }
}
