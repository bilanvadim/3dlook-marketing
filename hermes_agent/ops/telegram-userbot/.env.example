# telegram-userbot — copy to ~/.hermes/telegram-userbot/.env, fill, chmod 600
#
# Credentials for the Telethon userbot (session.session) used by the userbot
# helpers (login*.py, qr_login.py, search.py). Never commit .env or *.session.

# Same app as mtproto — https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here

# The phone number of the userbot account, international format, e.g. +33700000000
TG_PHONE=+00000000000

# 2FA / cloud password, if the account has one (leave blank otherwise)
TG_PASSWORD=
