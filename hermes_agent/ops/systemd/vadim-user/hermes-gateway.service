# Hermes Agent Gateway — the Telegram end of the system.
#
# This is the process that long-polls Telegram, runs claude_switcher's routing, and
# decides whether a message is conversation or a job. If it is down, Telegram goes
# silent; nothing else in the chain can compensate.
#
# ⚠️ THIS FILE IS REGENERATED BY `hermes update`. DO NOT HAND-EDIT IT.
#
# Measured 2026-08-27: the update at 16:17:16 rewrote the live unit — it stripped this
# comment block, replaced every %h with a literal /home/vadim_prod, and raised
# TimeoutStopSec from 60 to 70. The previous tracked copy had been hand-improved with
# %h and documentation, so the tracked and live files disagreed within a day and the
# repo copy looked like the newer one while being the one that never runs.
#
# So this copy is a CAPTURE, kept for backup and for diffing, not a template to install.
# Anything we genuinely want to differ from upstream belongs in a drop-in
# (hermes-gateway.service.d/*.conf), which `hermes update` does not touch — the same
# pattern hermes-conductor.service already uses for its five deployment drop-ins.
# bootstrap/verify.sh compares this file against the live one and reports drift rather
# than "fixing" it, because upstream is allowed to change its own unit.
#
# Two exit codes carry meaning and must not be "simplified" away:
#   75 — planned restart. RestartForceExitStatus keeps systemd restarting even if the
#        code would otherwise be treated as a clean stop. Note that 75 alone proves
#        nothing about health: it is also what a normal planned restart emits, so look
#        for the CRITICAL line in the log before concluding a crash.
#   78 — configuration error. RestartPreventExitStatus stops the restart loop, because
#        restarting on a bad config just burns the box.
[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/vadim_prod/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/vadim_prod/.hermes
Environment="PATH=/home/vadim_prod/.hermes/hermes-agent/venv/bin:/home/vadim_prod/.hermes/hermes-agent/node_modules/.bin:/home/vadim_prod/.hermes/node/bin:/home/vadim_prod/.hermes/node:/home/vadim_prod/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/vadim_prod/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/vadim_prod/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/vadim_prod/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
