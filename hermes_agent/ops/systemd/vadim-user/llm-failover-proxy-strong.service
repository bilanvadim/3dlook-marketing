[Unit]
Description=llm-failover-proxy (strong chain) — coding agent + heavy mode
After=network-online.target

[Service]
ExecStart=/usr/bin/node /usr/lib/node_modules/llm-failover-proxy/dist/index.js start --config /home/vadim_prod/.config/llm-failover-proxy/config-strong.json
StandardOutput=append:/home/vadim_prod/.config/llm-failover-proxy/daemon-strong.log
StandardError=append:/home/vadim_prod/.config/llm-failover-proxy/daemon-strong.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
