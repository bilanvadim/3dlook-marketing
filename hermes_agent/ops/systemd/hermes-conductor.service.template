[Unit]
Description=Hermes Conductor — autonomous Fullstack-agents worker (Claude Agent SDK → Postgres hc_*)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# Tokens below are filled by install.sh (user, home, repo root, stack env path).
User=@USER@
Environment=HOME=@HOME@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HERMES_REPO_ROOT=@REPO_ROOT@
Environment=STACK_ENV=@STACK_ENV@
EnvironmentFile=@REPO_ROOT@/claude_code/DEV/full_stack_sm/conductor/.env
WorkingDirectory=@REPO_ROOT@/claude_code/DEV/full_stack_sm/conductor
ExecStart=@REPO_ROOT@/hermes_agent/ops/conductor-run.sh
Restart=always
RestartSec=5
# Cost is not capped by design; the only runaway control is the in-process breaker.

[Install]
WantedBy=multi-user.target
