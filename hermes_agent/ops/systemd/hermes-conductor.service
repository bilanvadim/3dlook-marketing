[Unit]
Description=Hermes Orchestrator Conductor — autonomous worker (Claude Agent SDK → SQLite/libSQL ho_*)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/vadim_prod
# ~/.local/bin first so the conductor finds the `claude` CLI when a job runs.
Environment=PATH=/home/vadim_prod/.local/bin:/usr/local/bin:/usr/bin:/bin
# State is SQLite/libSQL — no docker/Postgres dependency. conductor-run.sh defaults
# DATABASE_URL to file:$HOME/.hermes/ho.db; override in the .env for Turso/libSQL.
EnvironmentFile=-/home/vadim_prod/3dlook-marketing/claude_code/DEV/full_stack_sm/conductor/.env
WorkingDirectory=/home/vadim_prod/3dlook-marketing/claude_code/DEV/full_stack_sm/conductor
ExecStart=/home/vadim_prod/3dlook-marketing/hermes_agent/ops/conductor-run.sh
Restart=always
RestartSec=5
# Cost is not capped by design; the only runaway control is the in-process breaker.

# Installed as a systemd --user service (like hermes-gateway), linger enabled so
# it survives logout/reboot:
#   cp hermes-conductor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now hermes-conductor.service
[Install]
WantedBy=default.target
