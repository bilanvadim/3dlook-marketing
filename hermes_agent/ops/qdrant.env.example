# ~/.hermes/qdrant-server/qdrant.env — read by hermes-qdrant.service. chmod 600.
# Generate the key with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
#
# The API key is NOT optional on a shared box: Qdrant ships with no auth at all, so
# an unkeyed 127.0.0.1 instance is readable by every local user. Verify after start:
#   curl -s -o /dev/null -w '%{http_code}\n' http://127.0.0.1:6343/collections        # → 401
#   curl -s -o /dev/null -w '%{http_code}\n' -H "api-key: $KEY" ...                   # → 200
#
# Ports: pick a pair nobody else on the host uses. 6333/6334 are Qdrant's defaults,
# so a second user's instance must move (this box runs 6343/6344 for vadim_prod).
QDRANT__SERVICE__HOST=127.0.0.1
QDRANT__SERVICE__HTTP_PORT=6343
QDRANT__SERVICE__GRPC_PORT=6344
QDRANT__SERVICE__API_KEY=REPLACE_WITH_GENERATED_KEY
QDRANT__SERVICE__ENABLE_TLS=false
QDRANT__TELEMETRY_DISABLED=true
QDRANT__STORAGE__STORAGE_PATH=/home/YOUR_USER/.hermes/qdrant-server/storage
QDRANT__STORAGE__SNAPSHOTS_PATH=/home/YOUR_USER/.hermes/qdrant-server/snapshots
