QDRANT__SERVICE__HOST=127.0.0.1
QDRANT__SERVICE__HTTP_PORT=@QDRANT_HTTP_PORT@
QDRANT__SERVICE__GRPC_PORT=@QDRANT_GRPC_PORT@
QDRANT__SERVICE__API_KEY=
QDRANT__SERVICE__ENABLE_TLS=false
QDRANT__TELEMETRY_DISABLED=true
QDRANT__STORAGE__STORAGE_PATH=@HERMES_HOME@/qdrant-server/storage
QDRANT__STORAGE__SNAPSHOTS_PATH=@HERMES_HOME@/qdrant-server/snapshots
