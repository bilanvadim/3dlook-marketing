# ~/.hermes/ai-models.env — API-ключи сторонних БЕСПЛАТНЫХ провайдеров моделей.
# chmod 600. Создаётся роутером автоматически; сюда же кладутся ключи, которые бот
# просит в Telegram, когда провайдер из топ-3 остался без ключа.
#
# Читается в таком порядке: этот файл → ~/.hermes/.env, по всем алиасам имён из
# models.dev. Поэтому ключ Google AI Studio уже находится в существующем
# OPENAI_API_KEY (это Gemini-ключ; имя переменной требует OpenAI-адаптер mem0) и
# отдельно его дублировать не нужно.
#
# Имена переменных = как их называет models.dev, иначе роутер их не найдёт.
# Кто попадает в топ-3 — решает порядок в
# github.com/open-free-llm-api/awesome-freellm-apis (таблица PERMANENT_FREE,
# отсортирована по числу бесплатных моделей); он меняется, так что список ниже
# со временем расширится.

OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY          # https://openrouter.ai/keys
                                              # (с 08.08.2026 вне ротации: репо
                                              #  перенёс его в Renewable Credits)
NVIDIA_API_KEY=nvapi-YOUR_KEY                 # https://build.nvidia.com
MODELSCOPE_API_KEY=ms-YOUR_TOKEN              # https://modelscope.cn/my/myaccesstoken
                                              # ⚠️ после выпуска токена ОБЯЗАТЕЛЬНО
                                              #  привязать аккаунт Alibaba Cloud:
                                              #  https://modelscope.ai/my/settings/account
                                              #  иначе генерация отвечает 401, хотя
                                              #  токен валиден и /v1/models отдаёт 200
CLOUDFLARE_API_KEY=cfat_YOUR_TOKEN            # https://dash.cloudflare.com/profile/api-tokens
                                              # ⚠️ аккаунт-scoped токен (cfat_…) НЕ
                                              #  проходит /user/tokens/verify — это
                                              #  нормально, не признак битого ключа
CLOUDFLARE_ACCOUNT_ID=                        # можно не заполнять: роутер найдёт сам
                                              #  по токену и допишет сюда. Нужен
                                              #  потому, что сидит внутри base URL:
                                              #  /accounts/<id>/ai/v1
# GOOGLE_API_KEY=YOUR_KEY                     # https://aistudio.google.com/app/apikey
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
# HF_TOKEN=
# AI_GATEWAY_API_KEY=                         # Vercel AI Gateway
# KILO_API_KEY=
