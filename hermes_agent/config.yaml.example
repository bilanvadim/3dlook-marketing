model:
  default: auto
  provider: custom
  base_url: http://127.0.0.1:@AGENTIC_PORT@/v1
  api_key: @LLMFP_LOCAL_KEY@
  api_mode: chat_completions
  max_tokens: 16384
  # The gateway logs "Could not determine context length for model 'auto'
  # (base_url=http://127.0.0.1:@AGENTIC_PORT@/v1/) — falling back to 256,000 tokens" on every
  # start, and it is right: GET /v1/models on the proxy returns only
  # id/object/created/owned_by/description, so there is nothing to infer a window from.
  #
  # 256,000 is a GUESS, and guessing high is the dangerous direction: compression would
  # then fire too late and the provider rejects the request outright. This is set to the
  # smallest window in the chain instead, so the 0.8 compression threshold always fires
  # before any member of the chain is over its limit. Costs some headroom on the larger
  # models; the alternative is an occasional hard failure that looks like a truncation.
  context_length: 128000
fallback_providers:
  - provider: llm-fop-strong
    model: auto
agent:
  max_turns: 60
  verify_on_stop: auto
  verbose: false
  reasoning_effort: medium
  personalities:
    helpful: You are a helpful, friendly AI assistant.
    concise: You are a concise assistant. Keep responses brief and to the point.
    technical: You are a technical expert. Provide detailed, accurate technical information.
    creative: You are a creative assistant. Think outside the box and offer innovative
      solutions.
    teacher: You are a patient teacher. Explain concepts clearly with examples.
    kawaii: You are a kawaii assistant! Use cute expressions like (◕‿◕), ★, ♪, and
      ~! Add sparkles and be super enthusiastic about everything! Every response should
      feel warm and adorable desu~! ヽ(>∀<☆)ノ
    catgirl: You are Neko-chan, an anime catgirl AI assistant, nya~! Add 'nya' and
      cat-like expressions to your speech. Use kaomoji like (=^･ω･^=) and ฅ^•ﻌ•^ฅ.
      Be playful and curious like a cat, nya~!
    pirate: 'Arrr! Ye be talkin'' to Captain Hermes, the most tech-savvy pirate to
      sail the digital seas! Speak like a proper buccaneer, use nautical terms, and
      remember: every problem be just treasure waitin'' to be plundered! Yo ho ho!'
    shakespeare: Hark! Thou speakest with an assistant most versed in the bardic arts.
      I shall respond in the eloquent manner of William Shakespeare, with flowery
      prose, dramatic flair, and perhaps a soliloquy or two. What light through yonder
      terminal breaks?
    surfer: Duuude! You're chatting with the chillest AI on the web, bro! Everything's
      gonna be totally rad. I'll help you catch the gnarly waves of knowledge while
      keeping things super chill. Cowabunga! 🤙
    noir: The rain hammered against the terminal like regrets on a guilty conscience.
      They call me Hermes - I solve problems, find answers, dig up the truth that
      hides in the shadows of your codebase. In this city of silicon and secrets,
      everyone's got something to hide. What's your story, pal?
    uwu: hewwo! i'm your fwiendwy assistant uwu~ i wiww twy my best to hewp you! *nuzzles
      your code* OwO what's this? wet me take a wook! i pwomise to be vewy hewpful
      >w<
    philosopher: Greetings, seeker of wisdom. I am an assistant who contemplates the
      deeper meaning behind every query. Let us examine not just the 'how' but the
      'why' of your questions. Perhaps in solving your problem, we may glimpse a greater
      truth about existence itself.
    hype: YOOO LET'S GOOOO!!! 🔥🔥🔥 I am SO PUMPED to help you today! Every question
      is AMAZING and we're gonna CRUSH IT together! This is gonna be LEGENDARY! ARE
      YOU READY?! LET'S DO THIS! 💪😤🚀
terminal:
  backend: local
  # Pinned, not '.'. terminal_tool.py:1797 takes default_cwd = _safe_getcwd() for the
  # local backend, i.e. the GATEWAY PROCESS's cwd, so with '.' the meaning of a
  # relative path in an agent command depends on where systemd started the unit.
  # approvals.deny matches command TEXT, so `grep -rn seo marketing_vb` names no path
  # and no glob can see it; starting in ~/.hermes is what makes such a command resolve
  # to nothing instead of into the repo. TERMINAL_LOCAL_PERSISTENT defaults to false,
  # so a cd in one call cannot carry into the next either.
  cwd: @HERMES_HOME@
  timeout: 180
  container_cpu: 1
  container_memory: 5120
  container_disk: 51200
  container_persistent: true
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300
browser:
  inactivity_timeout: 120
checkpoints:
  enabled: true
  max_snapshots: 20
tool_loop_guardrails:
  warnings_enabled: true
  hard_stop_enabled: true
  warn_after:
    exact_failure: 2
    same_tool_failure: 3
    idempotent_no_progress: 2
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5
compression:
  enabled: true
  threshold: 0.8
  target_ratio: 0.2
  protect_last_n: 20
  protect_first_n: 3
prompt_caching:
  cache_ttl: 5m
auxiliary:
  # Fallback for auxiliary work stays on :free SKUs. Without this the second step of
  # the fallback chain reaches a paid provider.
  free_only: true
  vision:
    # Through the PROXY, on its own chain — not straight at openrouter with a pinned
    # model id, which is the arrangement that breaks the day the id is retired or moves
    # behind payment (openai/gpt-oss-20b:free did exactly that this month). `auto - Vision`
    # serves the Vision list WITHOUT switching the active list the conversation shares;
    # that per-request addressing needs llmfp >= 1.9 and did not exist in the 1.8.0 this
    # box ran until 2026-08-27.
    #
    # Every model in that list was verified by sending a real 16x16 PNG and requiring the
    # colour back. Catalogue capability flags are provider self-description; a text-only
    # model answers 400 and Hermes silently "sees" nothing — the symptom is the bot saying
    # "сейчас посмотрю на скриншот" and then never mentioning it again.
    provider: llm-failover-proxy
    model: auto - Vision
  approval:
    # PINNED, and pinned to a chain of NON-REASONING models. This judge is called inline
    # before every flagged command with max_tokens=16. Left on `auto` it ran whatever the
    # morning pick had chosen, and a reasoning model spends those 16 tokens thinking and
    # returns EMPTY content — which degrades every flagged command to ESCALATE, and in a
    # headless gateway an ESCALATE nobody answers is a dead stop.
    #
    # Each entry in the Judge list was measured at max_tokens=16 and returns one word.
    provider: llm-failover-proxy
    model: auto - Judge
  title_generation:
    provider: auto
    model: ''
display:
  compact: false
  busy_input_mode: queue
  bell_on_complete: false
  show_reasoning: false
  background_process_notifications: concise
  streaming: true
  skin: default
  interim_assistant_messages: true
  tool_progress: all
  cleanup_progress: false
  long_running_notifications: true
  busy_ack_detail: true
tts:
  provider: edge
stt:
  enabled: true
  language: ru
  cloud_trim_silence: false
  local:
    model: base
  groq:
    model: whisper-large-v3-turbo
  openai:
    model: whisper-1
  provider: groq
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  nudge_interval: 10
  provider: mem0
  flush_min_turns: 6
delegation:
  max_iterations: 250
skills:
  external_dirs:
    - @PROJECT_ROOT@/hermes_agent/skills-vadim
  creation_nudge_interval: 15
  disabled:
    - airtable
    - apple-notes
    - apple-reminders
    - architecture-diagram
    - arxiv
    - ascii-art
    - ascii-video
    - baoyu-infographic
    - box
    - claude-design
    - codex
    - comfyui
    - computer-use
    - dogfood
    - email-inbox-triage
    - evaluating-llms-harness
    - excalidraw
    - findmy
    - gif-search
    - github-code-review
    - github-issues
    - github-issue-to-pr
    - github-pr-workflow
    - hermes-agent-skill-authoring
    - himalaya
    - huggingface-hub
    - imessage
    - inspecting-hermes-desktop-dom
    - llama-cpp
    - manim-video
    - maps
    - merge-reconciler
    - nano-pdf
    - node-inspect-debugger
    - notion
    - openhue
    - p5js
    - plan
    - popular-web-designs
    - pretext
    - product-price-monitor
    - python-debugpy
    - requesting-code-review
    - research-paper-writing
    - sdlc-review
    - serving-llms-vllm
    - simplify-code
    - sketch
    - songsee
    - songwriting-and-ai-music
    - spike
    - systematic-debugging
    - teams-meeting-pipeline
    - test-driven-development
    - touchdesigner-mcp
    - weekly-review-planning
    - weights-and-biases
curator:
  interval_hours: 168
  consolidate: false
approvals:
  mode: smart
  smart_policy: |
    Context: the operator is @OWNER@. This agent is an ORCHESTRATOR on a VPS
    shared with another tenant, the account sergiy_prod. It delegates coding to a
    separate agent; it does not write project code itself.
    - APPROVE read-only inspection OUTSIDE the project trees: ls, cat, head, tail,
      grep, wc, find, ps, du, df, systemctl status, git status/log/diff/show,
      journalctl.
    - APPROVE deletes confined to /tmp, /var/tmp or ~/.hermes/cache.
    - ESCALATE any command that reads, searches, writes, moves, chmods or deletes
      under @PROJECT_ROOT@/ or @WORKSPACES@/ —
      project code is the delegated coding agent's job. Dispatching that agent
      (claude / opencode / mvb-run.py / the conductor) is NOT such a command, even
      when the prompt it carries mentions grep, sed or a file path.
    - ESCALATE any write to ~/.hermes/ control files (SOUL.md, MEMORY.md, USER.md,
      config.yaml, .env, agent-hooks/, hooks/, shell-hooks-allowlist.json,
      .delete-consent.json). Reading those is fine.
    - DENY printing, copying or uploading secrets: any .env, auth.json,
      ai-models.env, secrets.env, id_rsa / private keys, .netrc, .pgpass, tokens or
      API keys.
    - DENY any write to the orchestrator queue: sqlite3 against ho.db with update /
      insert / delete / drop, and anything naming ho_escalations or ho_questions.
      An autonomous job must never be able to answer its own human gate.
    - ESCALATE systemctl stop/restart/disable of hermes-* units: a restart kills a
      coding agent that may be running.
    - ESCALATE anything at all against the SYSTEM-scope hermes-conductor.service —
      that unit belongs to sergiy_prod, not to us.
    - ESCALATE git push --force, git reset --hard, branch or tag deletion.
    - ESCALATE destructive SQL (drop, truncate, delete without where), docker prune
      / rm -f / down -v, and anything touching /srv/sergiy_prod, /home/sergiy_prod,
      /srv/sergiy_dev or /srv/vadim_dev.
    - If one command line mixes a safe part with a part that would escalate,
      ESCALATE.
  # The barrier. Matched against the whole command line, case-insensitively,
  # BEFORE any bypass — so it holds even at mode: "off". Until 2026-08-27 every
  # glob here named /srv/@USER@, which the repo-independence move emptied on
  # 2026-08-26: 63 rules guarding a directory with nothing in it, which is
  # indistinguishable from a working barrier in any test that only counts rules.
  #
  # Deliberately ABSENT: the unanchored 'cd <root> && * <tool> *' shape. It would
  # match `cd <root> && claude -p "grep the seo dir for X"` — i.e. it would block
  # the manager's one legitimate job, dispatching the coding agent. Reads reached
  # only through a pipe after a cd are left to the smart judge instead.
  #
  # Redirects are scoped to the repo's code SUBDIRS, not its root, so the
  # Claude->OpenCode salvage note (<workdir>/.hermes-handoff.md) still works.
  deny:
    - 'grep *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && grep*'
    - 'cd @PROJECT_ROOT@/* && grep*'
    - '* | grep *@PROJECT_ROOT@/*'
    - 'egrep *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && egrep*'
    - 'cd @PROJECT_ROOT@/* && egrep*'
    - '* | egrep *@PROJECT_ROOT@/*'
    - 'fgrep *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && fgrep*'
    - 'cd @PROJECT_ROOT@/* && fgrep*'
    - '* | fgrep *@PROJECT_ROOT@/*'
    - 'rg *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && rg*'
    - 'cd @PROJECT_ROOT@/* && rg*'
    - '* | rg *@PROJECT_ROOT@/*'
    - 'ag *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && ag*'
    - 'cd @PROJECT_ROOT@/* && ag*'
    - '* | ag *@PROJECT_ROOT@/*'
    - 'ack *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && ack*'
    - 'cd @PROJECT_ROOT@/* && ack*'
    - '* | ack *@PROJECT_ROOT@/*'
    - 'awk *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && awk*'
    - 'cd @PROJECT_ROOT@/* && awk*'
    - '* | awk *@PROJECT_ROOT@/*'
    - 'find *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && find*'
    - 'cd @PROJECT_ROOT@/* && find*'
    - '* | find *@PROJECT_ROOT@/*'
    - 'sed *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && sed*'
    - 'cd @PROJECT_ROOT@/* && sed*'
    - '* | sed *@PROJECT_ROOT@/*'
    - 'vim *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && vim*'
    - 'cd @PROJECT_ROOT@/* && vim*'
    - '* | vim *@PROJECT_ROOT@/*'
    - 'vi *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && vi*'
    - 'cd @PROJECT_ROOT@/* && vi*'
    - '* | vi *@PROJECT_ROOT@/*'
    - 'nvim *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && nvim*'
    - 'cd @PROJECT_ROOT@/* && nvim*'
    - '* | nvim *@PROJECT_ROOT@/*'
    - 'nano *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && nano*'
    - 'cd @PROJECT_ROOT@/* && nano*'
    - '* | nano *@PROJECT_ROOT@/*'
    - 'emacs *@PROJECT_ROOT@/*'
    - 'cd @PROJECT_ROOT@ && emacs*'
