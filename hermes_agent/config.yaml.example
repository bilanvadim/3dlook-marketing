    - '* > @PROJECT_ROOT@/scanme-lab/*'
    - '* >> @PROJECT_ROOT@/scanme-lab/*'
    - '* > @PROJECT_ROOT@/telegram-bot/*'
    - '* >> @PROJECT_ROOT@/telegram-bot/*'
    - '* > ~/3dlook-marketing/bootstrap/*'
    - '* >> ~/3dlook-marketing/bootstrap/*'
    - '* > ~/3dlook-marketing/brand-assets/*'
    - '* >> ~/3dlook-marketing/brand-assets/*'
    - '* > ~/3dlook-marketing/.claude/*'
    - '* >> ~/3dlook-marketing/.claude/*'
    - '* > ~/3dlook-marketing/claude_code/*'
    - '* >> ~/3dlook-marketing/claude_code/*'
    - '* > ~/3dlook-marketing/docs/*'
    - '* >> ~/3dlook-marketing/docs/*'
    - '* > ~/3dlook-marketing/hermes_agent/*'
    - '* >> ~/3dlook-marketing/hermes_agent/*'
    - '* > ~/3dlook-marketing/logs/*'
    - '* >> ~/3dlook-marketing/logs/*'
    - '* > ~/3dlook-marketing/marketing_vb/*'
    - '* >> ~/3dlook-marketing/marketing_vb/*'
    - '* > ~/3dlook-marketing/opencode_agent/*'
    - '* >> ~/3dlook-marketing/opencode_agent/*'
    - '* > ~/3dlook-marketing/scanme-lab/*'
    - '* >> ~/3dlook-marketing/scanme-lab/*'
    - '* > ~/3dlook-marketing/telegram-bot/*'
    - '* >> ~/3dlook-marketing/telegram-bot/*'
    - '* > @WORKSPACES@/*/*'
    - '* >> @WORKSPACES@/*/*'
    - '* > ~/workspaces/*/*'
    - '* >> ~/workspaces/*/*'
  destructive_slash_confirm: false
# MUST stay empty. Entries here are not commands but whole CATEGORIES of dangerous
# pattern, granted forever, and they are written by the "Always" button in chat.
# Until 2026-08-27 this held exactly three — 'script execution via heredoc',
# 'execute_code' and 'script execution via -e/-c flag' — i.e. an unrestricted write
# primitive that no deny glob above can see, since none of them mention a path.
# In chat press Once or Session, never Always. hermes-update.py alerts if this
# ever becomes non-empty again.
command_allowlist: []
hooks:
  pre_llm_call:
    - command: @HERMES_HOME@/agent-hooks/note-delete-consent.py
      timeout: 10
    - command: @HERMES_HOME@/agent-hooks/suggest-stronger-model.py
      timeout: 10
  pre_tool_call:
    - matcher: write_file|patch
      command: @HERMES_HOME@/agent-hooks/block-project-writes.py
      timeout: 10
    - matcher: terminal|execute_code
      command: @HERMES_HOME@/agent-hooks/block-destructive-terminal.py
      timeout: 10
security:
  website_blocklist:
    enabled: true
    domains:
      - 169.254.169.254
      - metadata.google.internal
      - '*.internal'
code_execution:
  timeout: 300
  max_tool_calls: 50
streaming:
  enabled: false
onboarding:
  seen:
    busy_input_prompt: true
    profile_build_offered: true
updates:
  pre_update_backup: false
  backup_keep: 2
  non_interactive_local_changes: stash
_config_version: 39
session_reset:
  mode: both
  idle_minutes: 1440
  at_hour: 4
group_sessions_per_user: true
platform_toolsets:
  cli:
    - browser
    - clarify
