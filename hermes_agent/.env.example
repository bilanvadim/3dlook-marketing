# Скопировать в ~/.hermes/.env и заполнить реальными значениями, затем:
#   chmod 600 ~/.hermes/.env
# Подробности "как получить значения" — см. SETUP.md §4.

# === Провайдеры LLM (OpenCode) ===
# GO убран: роутинг только через llm-failover-proxy (провайдер opencode = zen).

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Optional: a "home channel" the bot posts status/digests to (id + topic thread)
TELEGRAM_HOME_CHANNEL=447975871
TELEGRAM_HOME_CHANNEL_THREAD_ID=

# === AI Second Brain (Obsidian wiki) ===
WIKI_PATH=@HERMES_HOME@/AI-Second-Brain
OBSIDIAN_VAULT_PATH=@HERMES_HOME@/AI-Second-Brain

# === STT (распознавание голосовых сообщений) ===

# === Browser (опционально) ===
AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
BROWSER_SESSION_TIMEOUT=600
BROWSER_INACTIVITY_TIMEOUT=120
# Browserbase (опционально — облачный headless-браузер вместо локального)
BROWSERBASE_ADVANCED_STEALTH=false
BROWSERBASE_PROXIES=true

# === Terminal tool (опционально) ===
TERMINAL_LIFETIME_SECONDS=300
TERMINAL_TIMEOUT=60
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# === Debug-флаги инструментов (опционально; 1 = verbose логи) ===
IMAGE_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
WEB_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false


# === Mem0 OSS через Gemini ===
# Mem0's OpenAI adapter uses this variable name for the Gemini key.
# The endpoint and models are configured in mem0.json.example.
OPENAI_API_KEY=

# === Прочие опциональные ключи (раскомментировать при использовании) ===
# Нужен auxiliary.vision: чтение картинок идёт напрямую через OpenRouter,
# потому что llmfp 1.8.0 не умеет адресовать списки, а vision-моделей в
# активном списке нет. Единственный оставшийся путь мимо прокси.
OPENROUTER_API_KEY=
# GITHUB_TOKEN=             # git-операции агента / gh CLI; заодно снимает лимит
#                           # Skills Hub 60 -> 5000 req/hr (`gh auth token`)
# SEARXNG_URL=http://127.0.0.1:8888   # веб-поиск, см. ops/searxng/README.md.
#                           # ТОЛЬКО здесь: `hermes config set` кладёт в config.yaml,
#                           # а провайдер читает environ/.env
# VERCEL_TOKEN=             # деплой на Vercel
# EXA_API_KEY=             # web-search провайдер
# FIRECRAWL_API_KEY=       # web-scraping
HERMES_CLAUDE_SWITCHER_WORKDIR=@PROJECT_ROOT@
HERMES_OWNER="@OWNER@"
HERMES_GH_OWNER=@GH_OWNER@
HERMES_PROJECT_ROOT=@PROJECT_ROOT@
HERMES_CUSTOM_127_0_0_1_@AGENTIC_PORT@_API_KEY=
HERMES_CUSTOM_127_0_0_1_@STRONG_PORT@_API_KEY=
HERMES_AGENTIC_CHAIN_URL=http://127.0.0.1:@AGENTIC_PORT@/v1
HERMES_STRONG_CHAIN_URL=http://127.0.0.1:@STRONG_PORT@/v1
HERMES_STRONG_CHAIN_LOG=@HOME@/.config/llm-failover-proxy/daemon-strong.log
HERMES_VISION_PINNED=opencode-zen/mimo-v2.5-free

# ── выровнено с canonical 2026-08-12 (§7: общая конфигурация) ────────────────
SEARXNG_URL=http://127.0.0.1:8888
GITHUB_TOKEN=

# opencode-zen: мелкая быстрая модель для заголовков сессий (как у sergiy_prod).
# Ключ его собственный, взят из ~/.config/llm-failover-proxy/config.json.

# Бот, чью переписку MTProto-хелпер опрашивает на живые топики для пикера
# пересылок. Без этого list_topics.py берёт захардкоженный дефолт
# ivan_djedaev_bot (бот Сергея) и возвращает topics:{} — пикер не появляется.
MT_BOT=@TELEGRAM_BOT@

# STT (расшифровка голосовых, в т.ч. пересланных): stt.provider=groq.
# Ключ его собственный — лежал в ~/.hermes/ai-models.env, а этот файл
# загрузчик окружения НЕ читает (только ~/.hermes/.env, project .env, .op.env).
GROQ_API_KEY=

# Pins the terminal tool's starting directory. WITHOUT this, terminal_tool.py:1797
# takes default_cwd = _safe_getcwd() for the local backend — the GATEWAY PROCESS's
# cwd — so the meaning of a relative path in an agent command depends on where
# systemd happened to start the unit. approvals.deny matches command TEXT, so a
# bare `grep -rn seo marketing_vb` names no path and no glob can see it; pinning
# the start directory to ~/.hermes is what makes such a command resolve to
# nothing instead of into the repo. (local_persistent defaults to false, so cwd
# also cannot carry over from a previous `cd` in an earlier call.)
